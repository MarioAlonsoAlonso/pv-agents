# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Fase 1: adaptador entrenado que sirve /reasoning (y el cerebro rlm y la herramienta code_meddra
# del agente), y verificador (meddra es el de nuestro dominio). Id del Hub (Qwen3-1.7B, SFT + GRPO)
# o una carpeta local con el adaptador.
ARCA_RLM_ADAPTER=Matteofermar/arca-meddra-qwen3-1.7b
ARCA_RLM_VERIFIER=meddra

# Carpeta MedAscii de la distribución oficial de MedDRA, si tenéis licencia. Sin ella se usa el
# subconjunto de 90 PT incluido en rlm/meddra.py.
# ARCA_MEDDRA_DIR=/ruta/a/MedDRA/MedAscii

# Identificación del equipo: sale en /health
ARCA_TEAM=
ARCA_DOMAIN=farmacovigilancia: codificación MedDRA y consulta de fichas técnicas

# Modelo de chat compartido por /rag, /tools y el cerebro "base" de /agent (common/llm.py)
# ARCA_LLM_MODEL=Qwen/Qwen3-1.7B

# Fase 3 (rag/generate.py). Los valores por defecto salen de rag/evaluate.py.
# ARCA_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# ARCA_RAG_CHUNKING=recursive
# ARCA_RAG_LAMBDA=0.3
# ARCA_RAG_INSTRUCTION=pharmacovigilance
# ARCA_RAG_MIN_SCORE=0

# Modelo remoto: el servidor vLLM de los profesores (Qwen3.8-27B-FP8), solo accesible desde una
# sesión de la DGX. Desde noviembre de 2026: dirección 0.0.0.0:8001 y con clave API (la del correo de
# los profesores; NO la pongáis en ningún fichero que se suba a git). docs/dgx-instructions.pdf
# todavía muestra la dirección antigua (127.0.0.1:8000, sin clave).
ARCA_REMOTE_LLM_URL=http://0.0.0.0:8001/v1
ARCA_REMOTE_LLM_API_KEY=
ARCA_REMOTE_LLM_MODEL=qwen3.8-27b-fp8
# Peticiones simultáneas al servidor (lo comparten todos los equipos; admite 5 en total)
ARCA_REMOTE_LLM_CONCURRENCY=2

# Rastreador de Bluesky. Usuario completo (tu_usuario.bsky.social) y una contraseña de
# aplicación (Ajustes > Privacidad y seguridad > Contraseñas de aplicación), nunca la de la cuenta.
BSKY_HANDLE=
BSKY_APP_PASSWORD=
