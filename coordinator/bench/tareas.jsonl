{"id": "c03", "categoria": "casos", "tarea": "Resume el caso {caso_indirecto}: qué le pasó al paciente y de dónde sale la información si el post no lo dice.", "herramientas": ["ver_caso"], "comprobar": [{"type": "contains", "value": "{caso_indirecto}"}, {"type": "regex", "value": "(?i)conversaci|mensaje anterior|respond|hilo"}]}
